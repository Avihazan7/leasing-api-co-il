# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMAC request signing shared secret (used by /v1 routes)
HMAC_SECRET=change-me

# Optional: skip HMAC verification in local development ("true" to disable)
HMAC_DISABLED=false

# Server
PORT=3000
NODE_ENV=development
