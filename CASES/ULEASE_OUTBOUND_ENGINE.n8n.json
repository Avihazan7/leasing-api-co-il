        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"model\": \"claude-haiku-4-5\", \"max_tokens\": 400, \"messages\": [{\"role\": \"user\", \"content\": \"You score B2B supply prospects for ULease (car marketplace). Given the prospect JSON, return ONLY JSON {\\\"score\\\":0-10,\\\"reason\\\":\\\"...\\\"}. High = importer/leasing with stuck inventory and reachable. Prospect: {{ JSON.stringify($json) }}\"}]}",
        "options": {}
      },
      "id": "03-·-Intelligence-—-Claude-Haiku-(score)",
      "name": "03 · Intelligence — Claude Haiku (score)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// חילוץ ציון מתשובת Claude\nconst out = [];\nfor (const it of $input.all()){\n  const txt = it.json?.content?.[0]?.text ?? '{}';\n  let s=0,r='';\n  try{const j=JSON.parse(txt); s=j.score; r=j.reason;}catch(e){}\n  out.push({json:{...it.json, score:s, reason:r}});\n}\nreturn out;"
      },
      "id": "03-·-Parse-Score",
      "name": "03 · Parse Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
